{
  "name": "postcss-comments",
  "version": "2.0.0",
  "description": "Postcss plugin to prepend or append comments to CSS rules",
  "repository": "git@github.com:elchininet/postcss-comments.git",
  "author": "ElChiniNet",
  "license": "Apache-2.0",
  "keywords": [
    "postcss",
    "css",
    "postcss-plugin",
    "comments"
  ],
  "type": "module",
  "main": "index.js",
  "module": "esm/index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "require": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "import": {
        "types": "./esm/index.d.ts",
        "default": "./esm/index.js"
      }
    }
  },
  "files": [
    "esm/**/*",
    "index.d.ts",
    "index.js"
  ],
  "scripts": {
    "test": "jest --clearCache && jest --verbose",
    "lint": "eslint src/**/*.ts",
    "clean": "./scripts/clean.sh",
    "modify-dts": "replace-in-file --configFile=config.replace.json",
    "build": "pnpm clean && rollup --config rollup.config.mjs && pnpm modify-dts",
    "prepare": "pnpm build",
    "prepublishOnly": "pnpm lint && pnpm test",
    "version": "git add .",
    "postversion": "git push && git push --tags"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/eslint": "^9.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "eslint-plugin-jest": "^29.16.6",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "postcss": "^8.5.28",
    "replace-in-file": "^9.0.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.5",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-tsconfig-paths": "^1.5.2",
    "ts-jest": "^29.4.14",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "peerDependencies": {
    "postcss": "^8.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@11.15.0"
}
